{
  // Waitlist API for tnhc.dev. See src/index.js for the contract.
  "name": "tnhc-waitlist",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Only reachable through tnhc.dev; no separate workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tnhc.dev/api/waitlist*", "zone_name": "tnhc.dev" },
    { "pattern": "tnhc.dev/api/admin/*", "zone_name": "tnhc.dev" }
  ],
  "d1_databases": [
    // Pinned to the existing database so a deploy can never create a second,
    // empty one and orphan real signups.
    { "binding": "DB", "database_name": "tnhc-waitlist", "database_id": "9ef4cd9b-d44d-418a-825f-993b0b973ba9" }
  ],
  // Off by policy: Workers observability stores request logs (incl. client IPs) at Cloudflare — TNHC keeps no visitor logs.
  "observability": { "enabled": false }
}
